# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# NOTA: SUPABASE_SERVICE_ROLE_KEY non è usata da nessuna parte in src/ e NON va
# configurata in produzione: bypassa tutte le RLS.
# ⚠️ Sul cloud il dashboard Supabase chiama la chiave pubblica
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (formato sb_publishable_...), ma il codice legge
# il nome qui sopra: va messa sotto il NOSTRO nome. Sbagliarlo è un guasto silenzioso —
# il sito compila e si apre, semplicemente non parla col database.

# Cloudflare Turnstile (anti-bot, Fase 1)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Login con Google: "true" solo dove il provider OAuth è configurato davvero
# (non sullo staging). Assente o diverso da "true" = bottone nascosto.
# ⚠️ Inlinata alla build: cambiarla richiede un rebuild, non basta salvarla.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""
